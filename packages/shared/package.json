{
  "name": "@crm/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato compartido del CRM: schemas Zod, enums, matriz de permisos y helpers puros que usan servidor y cliente.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"shared: sin lint propio (tsc estricto + vitest)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
