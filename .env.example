# ─── Servidor (apps/server/.env) ─────────────────────────────────────────────
NODE_ENV=development
PORT=8082
LOG_LEVEL=info

# Postgres local (Homebrew). Crea la base con: createdb crm_skeleton_dev
# En macOS con Homebrew el usuario es el de tu sesión: postgresql://<tu_usuario>@localhost:5432/crm_skeleton_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_skeleton_dev

# Orígenes permitidos para el cliente (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Identidad. Con AUTH_ENABLED=false el servidor confía en la cabecera
# `X-Team-Email` y resuelve la fila de `team_users` (seam de desarrollo).
# Con AUTH_ENABLED=true hay que registrar un IdentityProvider real
# (ver apps/server/src/auth/identity.port.ts).
AUTH_ENABLED=false
# Dominio del equipo: un correo nuevo con este dominio se auto-provisiona como PENDIENTE.
TEAM_EMAIL_DOMAIN=example.com

# Clave compartida para los jobs (POST /api/v1/jobs/*). Rota en producción.
JOBS_API_KEY=dev-jobs-key-rotate-me

# ─── Cliente (apps/client/.env) ──────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8082/api/v1
