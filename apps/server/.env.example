NODE_ENV=development
PORT=8082
LOG_LEVEL=info
# En macOS con Homebrew el usuario es el de tu sesión: postgresql://<tu_usuario>@localhost:5432/crm_skeleton_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_skeleton_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_ENABLED=false
TEAM_EMAIL_DOMAIN=example.com
JOBS_API_KEY=dev-jobs-key-rotate-me
